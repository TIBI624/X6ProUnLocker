<Window x:Class="X6ProUnLocker.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:X6ProUnLocker"
        Title="X6ProUnLocker v1.1.0 — System Reanimator"
        Height="800" Width="1200" WindowStartupLocation="CenterScreen"
        Icon="Assets/app.ico" Background="#0D0D0D" Foreground="#E0E0E0">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="100"/><RowDefinition Height="*"/><RowDefinition Height="30"/></Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Height="100" Margin="10" Background="#111111">
            <Image Source="Assets/logo.png" Height="80" Margin="10"/>
            <TextBlock x:Name="TitleText" Text="X6ProUnLocker v1.1.0" FontSize="36" FontWeight="Bold" Foreground="#FFD700" VerticalAlignment="Center" Margin="10"/>
            <TextBlock x:Name="SubtitleText" Text="System Reanimator" FontSize="16" Foreground="#9E9E9E" VerticalAlignment="Center" Margin="10"/>
            <Button x:Name="LangBtn" Content="🌐 EN" Background="#333333" Foreground="#FFFFFF" BorderThickness="0" Padding="10,5" Margin="auto,0,10,0" Click="LangBtn_Click"/>
        </StackPanel>

        <!-- Env Status -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,85,0,0">
            <Border x:Name="EnvBorder" Background="#1B5E20" CornerRadius="15" Padding="15,8">
                <TextBlock x:Name="EnvText" Text="Environment: Normal mode" Foreground="#FFFFFF" FontWeight="Bold"/>
            </Border>
            <Button Content="🔄 Refresh" Background="#1976D2" Foreground="White" BorderThickness="0" Padding="15,8" Margin="10,0,0,0" Click="RefreshEnv_Click"/>
        </StackPanel>

        <!-- Tabs -->
        <TabControl Grid.Row="1" Margin="10" Background="#1A1A1A" Foreground="#E0E0E0">
            <TabItem Header="📊 Task Manager" Background="#222222">
                <Grid>
                    <StackPanel Orientation="Horizontal" Margin="5">
                        <Button Content="🔄 Refresh" Background="#1976D2" Foreground="White" Padding="10" Margin="5" Click="RefreshProcesses_Click"/>
                        <Button Content="⏹️ End task" Background="#D32F2F" Foreground="White" Padding="10" Margin="5" Click="EndProcess_Click"/>
                        <Button Content="💥 Force kill" Background="#E64A19" Foreground="White" Padding="10" Margin="5" Click="KillProcess_Click"/>
                        <Button Content="📋 Properties" Background="#7B1FA2" Foreground="White" Padding="10" Margin="5" Click="ShowProperties_Click"/>
                        <Button Content="📂 Open folder" Background="#2E7D32" Foreground="White" Padding="10" Margin="5" Click="OpenFolder_Click"/>
                    </StackPanel>
                    <DataGrid x:Name="ProcessGrid" Margin="5,50,5,5" AutoGenerateColumns="False" IsReadOnly="True" GridLinesVisibility="Horizontal" Background="#121212" Foreground="#E0E0E0" HeadersVisibility="Column">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="PID" Binding="{Binding Pid}" Width="80"/>
                            <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="200"/>
                            <DataGridTextColumn Header="Path" Binding="{Binding Path}" Width="300"/>
                            <DataGridTextColumn Header="Memory (MB)" Binding="{Binding MemoryMB}" Width="120"/>
                            <DataGridTextColumn Header="CPU %" Binding="{Binding CpuPercent}" Width="80"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
            <TabItem Header="💻 CMD Terminal" Background="#222222">
                <Grid><local:CmdTerminal x:Name="cmdTerminal" /></Grid>
            </TabItem>
            <TabItem Header="🛠️ System Tools" Background="#222222">
                <ScrollViewer>
                    <StackPanel>
                        <GroupBox Header="🔤 Fonts" BorderBrush="#4CAF50" Foreground="#FFFFFF" Margin="5">
                            <StackPanel>
                                <Button Content="🔤 Restore" Background="#2E7D32" Foreground="White" Padding="10" Margin="5" Click="RestoreFonts_Click"/>
                            </StackPanel>
                        </GroupBox>
                        <GroupBox Header="🔄 System Utilities" BorderBrush="#FF9800" Foreground="#FFFFFF" Margin="5">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal"><TextBox x:Name="ExePathBox" Width="300" Margin="5" IsReadOnly="True" Background="#222" Foreground="#FFF"/><Button Content="📁 Browse" Background="#1976D2" Foreground="White" Padding="10" Margin="5" Click="BrowseExe_Click"/></StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="🔄 CMD" Background="#F57C00" Foreground="White" Padding="10" Margin="5" Click="ReplaceCmd_Click"/>
                                    <Button Content="🔄 SETHC" Background="#E64A19" Foreground="White" Padding="10" Margin="5" Click="ReplaceSethc_Click"/>
                                    <Button Content="🔄 UTILMAN" Background="#FFC100" Foreground="Black" Padding="10" Margin="5" Click="ReplaceUtilman_Click"/>
                                    <Button Content="↩️ Restore" Background="#2E7D32" Foreground="White" Padding="10" Margin="5" Click="RestoreOriginals_Click"/>
                                </StackPanel>
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="🚀 Startup" Background="#222222">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="5">
                        <Button Content="🔄 Refresh" Background="#1976D2" Foreground="White" Padding="10" Margin="5" Click="RefreshStartup_Click"/>
                        <Button Content="➕ Add App" Background="#2E7D32" Foreground="White" Padding="10" Margin="5" Click="AddStartupApp_Click"/>
                        <Button Content="➖ Remove Selected" Background="#D32F2F" Foreground="White" Padding="10" Margin="5" Click="RemoveStartupApp_Click"/>
                    </StackPanel>
                    <DataGrid x:Name="StartupGrid" Grid.Row="1" Margin="5" AutoGenerateColumns="True" Background="#121212" Foreground="#E0E0E0"/>
                </Grid>
            </TabItem>
            <TabItem Header="📋 Logs" Background="#222222">
                <RichTextBox x:Name="LogBox" IsReadOnly="True" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" Background="#0A0A0A" Foreground="#CCCCCC"/>
            </TabItem>
        </TabControl>

        <StatusBar Grid.Row="2" Background="#000000">
            <StatusBarItem><TextBlock x:Name="StatusLabel" Text="Ready" Foreground="#FFD700" FontWeight="Bold"/></StatusBarItem>
        </StatusBar>
    </Grid>
</Window>